   "source": [
    "import random\n",
    "import datetime\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9432cd26-ff03-4ed5-b856-4f7b460603e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Connect to SQLite DB (or create it)\n",
    "conn = sqlite3.connect(\"sales_data.db\")\n",
    "cursor = conn.cursor()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "90a60c6e-c4c0-4fe5-bce5-39ff3b392c3a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<sqlite3.Cursor at 0x1dc74d909c0>"
      ]
     },
     "execution_count": 12,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Step 2: Create sales table\n",
    "cursor.execute(\"\"\"\n",
    "CREATE TABLE IF NOT EXISTS sales (\n",
    "    id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "    product TEXT,\n",
    "    quantity INTEGER,\n",
    "    price REAL,\n",
    "    date TEXT\n",
    ")\n",
    "\"\"\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9c85cb45-4ead-42ff-b114-158b724e1730",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Generate and insert 500 random sales records\n",
    "products = [\"Laptop\", \"Mouse\", \"Keyboard\", \"Monitor\", \"Printer\",\n",
    "            \"USB Cable\", \"Webcam\", \"Speaker\", \"Router\", \"Headphones\"]\n",
    "\n",
    "for _ in range(500):\n",
    "    product = random.choice(products)\n",
    "    quantity = random.randint(1, 20)\n",
    "    price = round(random.uniform(10.0, 500.0), 2)\n",
    "    sale_date = datetime.datetime(2024, 1, 1) + datetime.timedelta(days=random.randint(0, 365))\n",
    "    \n",
    "    cursor.execute(\"\"\"\n",
    "        INSERT INTO sales (product, quantity, price, date)\n",
    "        VALUES (?, ?, ?, ?)\n",
    "    \"\"\", (product, quantity, price, sale_date.strftime(\"%Y-%m-%d\")))\n",
    "\n",
    "conn.commit()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "2fc33758-f18b-4ab0-ab8b-e4d4067a2a52",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Run SQL query to get total quantity and revenue per product\n",
    "query = \"\"\"\n",
    "SELECT \n",
    "    product, \n",
    "    SUM(quantity) AS total_qty, \n",
    "    ROUND(SUM(quantity * price), 2) AS revenue \n",
    "FROM sales \n",
    "GROUP BY product\n",
    "ORDER BY revenue DESC\n",
    "\"\"\""
   ]
  },
